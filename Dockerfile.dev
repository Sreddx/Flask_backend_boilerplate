# Use an official Python runtime as the base image
FROM python:3.11-slim

# Set the working directory inside the container
WORKDIR /app

# Copy the application files
COPY . /app

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Expose the port dynamically from the .env file
ARG FLASK_RUN_PORT=5000
EXPOSE ${FLASK_RUN_PORT}

# Define environment variables for development
ENV FLASK_APP=app.py
ENV FLASK_ENV=development

# Run the Flask development server with dynamic port
CMD ["flask", "run", "--host=0.0.0.0", "--port=${FLASK_RUN_PORT}"]
